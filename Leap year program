import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter the year: ");
        int year = sc.nextInt();
        String ans = (year%400==0) || (year%4 == 0 && year%100!=0)?"Leap year":"not a leap year";
        System.out.println(ans);
    }
}
